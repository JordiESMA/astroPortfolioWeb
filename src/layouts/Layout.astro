---
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
}

const { title = 'Jordi | Terminal Portfolio' } = Astro.props;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body>
		<Navbar />
		<main>
			<slot />
		</main>
		<Footer />
	</body>
</html>

<style is:global>
	:root {
		--fondo: #0d1117;
		--texto: #e6ffe6;
		--verde-terminal: #33ff66;
		--gris-oscuro: #161b22;
		--borde: #30363d;
	}

	html, body {
		margin: 0;
		width: 100%;
		background-color: var(--fondo);
		color: var(--texto);
		font-family: "Courier New", Courier, monospace;
		scroll-behavior: smooth;
	}

	main {
		max-width: 800px;
		margin: 80px auto 0;
		padding: 0 20px 40px;
	}
</style>
