---
import projects from '../data/projects.json';
import es from '../data/es.json';
const { featured = false } = Astro.props;
const cards = featured ? projects.slice(0, 3) : projects;
const technologies = [...new Set(projects.flatMap(p => p.tecnologias))].sort();
const strings: Record<string, string> = es;
---
{!featured && <div class="filtro">
  <label for="filtro" data-idioma="proyectos_filtrar">{es.proyectos_filtrar}</label>
  <select id="filtro">
    <option value="" data-idioma="proyectos_todos">{es.proyectos_todos}</option>
    {technologies.map(t => <option>{t}</option>)}
  </select>
</div>}
<div class="rejilla tarjetas-proyecto">
  {cards.map(p => <article class="tarjeta proyecto" data-tech={JSON.stringify(p.tecnologias)}>
    <h3><a href={p.githubUrl}>{p.nombre}<span aria-hidden="true">↗</span></a></h3>
    {p.estadoKey && <small data-idioma={p.estadoKey}>{strings[p.estadoKey]}</small>}
    <p data-idioma={p.descripcionKey}>{strings[p.descripcionKey]}</p>
    <div class="badges">{p.tecnologias.map(t => <span>{t}</span>)}</div>
  </article>)}
</div>
<script>
  const filter = document.querySelector<HTMLSelectElement>('#filtro');
  filter?.addEventListener('change', () => {
    document.querySelectorAll<HTMLElement>('[data-tech]').forEach(card => {
      const tags: string[] = JSON.parse(card.dataset.tech!);
      card.hidden = Boolean(filter.value && !tags.includes(filter.value));
    });
  });
</script>
