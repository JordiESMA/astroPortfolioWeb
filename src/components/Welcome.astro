---
import translations from '../data/language.json'; 
import stackRaw from '../data/labelsLanguage.json'; 
import photoCV from '../assets/photo_cv.jpeg';

import navBar from '../components/Navbar.astro';
import footer from '../components/Footer.astro';

//We show my structure of the JSON, because it's necessary to a correct use
interface Tech {
  nombre: string;
  badge: string;
}

interface Bloque {
  categoria: string;
  tecnologias: Tech[];
}

//We transfer my stack JSON to another block to use it later
const stack = stackRaw as Bloque[];

//We say that the Language by default it's spanish, they can select catalan , english, spanish
const idiomaPorDefecto = "es" as keyof typeof translations;
const t = translations[idiomaPorDefecto];

---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <title>Jordi | Terminal Portfolio</title>
  </head>
  <body>

    <!-- NAVBAR CON SELECTOR DE IDIOMA -->
     <navBar />

    <main>
      <!-- SECCIÓN 1: INICIO Y SOBRE MÍ -->
      <section id="inicio" class="seccion">
        <div class="ventana-terminal anima-scroll">
          
          <div class="barra-terminal">
            <span class="punto rojo"></span>
            <span class="punto amarillo"></span>
            <span class="punto verde"></span>
          </div>
          
          <div class="cuerpo-terminal">
            <p class="comando">jordi@macbook:~$ whoami</p>
            <h1>Jordi Estirado</h1>
            <p class="respuesta" data-i18n="inicio_texto">{t.inicio_texto}</p>
            <img src={photoCV.src} alt="Foto Jordi" class="foto-terminal" />
            
            <br><br>

            <p class="comando">jordi@macbook:~$ cat sobre_mi.txt</p>
            <h2 class="subtitulo-terminal" data-i18n="sobreMi_titulo">{t.sobreMi_titulo}</h2>
            <p class="respuesta" data-i18n="sobreMi_texto">{t.sobreMi_texto}</p>

            <br>

            <p class="comando">jordi@macbook:~$ cat trayectoria.md</p>
            <h2 class="subtitulo-terminal" data-i18n="sobrePro_titulo">{t.sobrePro_titulo}</h2>
            <p class="respuesta" data-i18n="sobrePro_texto">{t.sobrePro_texto}</p>
            
            <span class="cursor">_</span>
          </div>
        </div>
      </section>

      <!-- SECCIÓN 2: LENGUAJES Y HABILIDADES -->
      <section id="sobre-mi" class="seccion">
        <h2 class="anima-scroll titulo-seccion">>_ <span data-i18n="lenguajes_titulo">{t.lenguajes_titulo}</span></h2>
        
        <div class="contenedor-stack">
          {stack.map((bloque) => (
            <div class="bloque-categoria anima-scroll">
              <h3 class="subtitulo-terminal">{bloque.categoria}</h3>
              
              <div class="grid-stack">
                {bloque.tecnologias.map((tech) => (
                  <img src={tech.badge} alt={tech.nombre} title={tech.nombre} class="badge-tech" />
                ))}
              </div>
            </div>
          ))}
        </div>

        <br><br>
        
        <h2 class="anima-scroll titulo-seccion">>_ <span data-i18n="habilidadesAptitudes_titulo">{t.habilidadesAptitudes_titulo}</span></h2>
        <p class="texto-limpio anima-scroll" data-i18n="habilidadesAptitudes_texto">{t.habilidadesAptitudes_texto}</p>
      </section>

      <!-- SECCIÓN 3: PROYECTOS -->
      <section id="proyectos" class="seccion">
        <h2 class="anima-scroll titulo-seccion">>_ <span data-i18n="proyectos_titulo">{t.proyectos_titulo}</span></h2>
        
        <div class="grid-proyectos">
          <div class="tarjeta-proyecto anima-scroll">
            <h3>🎮 RPG Java</h3>
            <p data-i18n="proyecto1_texto">{t.proyecto1_texto}</p>
          </div>

          <div class="tarjeta-proyecto anima-scroll">
            <h3>⚽ Buscador EA FC 26</h3>
            <p data-i18n="proyecto2_texto">{t.proyecto2_texto}</p>
          </div>

          <div class="tarjeta-proyecto anima-scroll">
            <div class="cabecera-proyecto">
              <h3>🔧 ERP Taller Mecánico</h3>
              <span class="badge" data-i18n="proyecto3_badge">{t.proyecto3_badge}</span>
            </div>
            <p data-i18n="proyecto3_texto">{t.proyecto3_texto}</p>
          </div>
        </div>
      </section>

      <!-- SECCIÓN 4: CONTACTO -->
      <section id="contacto" class="seccion">
        <h2 class="anima-scroll titulo-seccion">>_ <span data-i18n="contacto_titulo">{t.contacto_titulo}</span></h2>
        <div class="grid-contacto anima-scroll">
          <a href="#" class="btn-contacto">📧 <span data-i18n="contacto_email">{t.contacto_email}</span></a>
          <a href="#" class="btn-contacto">💼 <span data-i18n="contacto_linkedin">{t.contacto_linkedin}</span></a>
          <a href="#" class="btn-contacto">🐙 <span data-i18n="contacto_github">{t.contacto_github}</span></a>
        </div>
      </section>

    </main>

    <!-- SCRIPT PARA EL CAMBIO DE IDIOMA Y EL SCROLL -->
    <script define:vars={{ translations }}>
      const selector = document.getElementById('selector-idioma');
      
      selector.addEventListener('change', (e) => {
        const idiomaSeleccionado = e.target.value;
        const diccionario = translations[idiomaSeleccionado];

        document.querySelectorAll('[data-i18n]').forEach((elemento) => {
          const clave = elemento.getAttribute('data-i18n');
          if (diccionario[clave]) {
            elemento.textContent = diccionario[clave];
          }
        });
      });

      const observador = new IntersectionObserver((entradas) => {
        entradas.forEach((entrada) => {
          if (entrada.isIntersecting) {
            entrada.target.classList.add('visible');
          }
        });
      });

      const elementosOcultos = document.querySelectorAll('.anima-scroll');
      elementosOcultos.forEach((el) => observador.observe(el));
    </script>

  </body>
</html>

<style>
  :root {
    --fondo: #0d1117;
    --texto: #e6ffe6;
    --verde-terminal: #33ff66;
    --gris-oscuro: #161b22;
    --borde: #30363d;
  }

  body {
    margin: 0;
    background-color: var(--fondo);
    color: var(--texto);
    font-family: "Courier New", Courier, monospace;
    scroll-behavior: smooth;
  }

  .navbar {
    position: fixed;
    top: 0;
    width: 100%;
    background: rgba(13, 17, 23, 0.9);
    backdrop-filter: blur(5px);
    border-bottom: 1px solid var(--borde);
    z-index: 100;
  }

  .nav-contenido {
    max-width: 800px;
    margin: 0 auto;
    padding: 15px 20px;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .logo { font-weight: bold; color: var(--verde-terminal); }
  
  .enlaces { display: flex; align-items: center; gap: 15px; }
  .enlaces a { color: var(--texto); text-decoration: none; font-size: 0.9rem; transition: color 0.2s; }
  .enlaces a:hover { color: var(--verde-terminal); }

  .selector-terminal {
    background-color: var(--fondo);
    color: var(--verde-terminal);
    border: 1px solid var(--verde-terminal);
    padding: 4px 8px;
    border-radius: 4px;
    font-family: inherit;
    font-size: 0.85rem;
    cursor: pointer;
    outline: none;
  }

  .anima-scroll {
    opacity: 0;
    transform: translateY(40px);
    transition: opacity 0.6s ease-out, transform 0.6s ease-out;
  }
  .anima-scroll.visible { opacity: 1; transform: translateY(0); }

  main { max-width: 800px; margin: 80px auto 0; padding: 0 20px; }
  .seccion { min-height: 80vh; display: flex; flex-direction: column; justify-content: center; padding: 50px 0; }
  .titulo-seccion { color: var(--verde-terminal); margin-bottom: 20px; }
  .texto-limpio { color: #8b949e; line-height: 1.6; }

  .ventana-terminal {
    background: var(--gris-oscuro);
    border: 1px solid var(--borde);
    border-radius: 8px;
    overflow: hidden;
    box-shadow: 0 10px 30px rgba(0,0,0,0.5);
  }

  .barra-terminal { background: #21262d; padding: 10px; display: flex; gap: 8px; border-bottom: 1px solid var(--borde); }
  .punto { width: 12px; height: 12px; border-radius: 50%; }
  .rojo { background: #ff5f56; }
  .amarillo { background: #ffbd2e; }
  .verde { background: #27c93f; }

  .cuerpo-terminal { padding: 25px; }
  .comando { color: var(--verde-terminal); margin: 0 0 10px 0; font-weight: bold; }
  .subtitulo-terminal { color: #e6ffe6; font-size: 1.2rem; margin: 5px 0; }
  .respuesta { color: #8b949e; margin: 5px 0; line-height: 1.5; }
  .cuerpo-terminal h1 { margin: 0 0 10px 0; font-size: 2rem; }

  .foto-terminal { width: 100px; height: 100px; border-radius: 8px; margin-top: 10px; border: 1px dashed var(--verde-terminal); }
  .cursor { animation: parpadeo 1s infinite; color: var(--verde-terminal); font-weight: bold; }
  @keyframes parpadeo { 50% { opacity: 0; } }

  .contenedor-stack { display: flex; flex-direction: column; gap: 30px; }
  .bloque-categoria {
    background: var(--gris-oscuro);
    border: 1px solid var(--borde);
    padding: 20px;
    border-radius: 8px;
    border-left: 3px solid var(--verde-terminal);
  }
  .grid-stack { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 15px; }
  
  .badge-tech {
    height: 28px;
    border-radius: 4px;
    transition: transform 0.2s ease;
    box-shadow: 0 4px 6px rgba(0,0,0,0.3);
  }
  .badge-tech:hover { transform: scale(1.1); }

  .grid-proyectos { display: flex; flex-direction: column; gap: 20px; }
  .tarjeta-proyecto {
    background: var(--gris-oscuro);
    border: 1px solid var(--borde);
    padding: 20px;
    border-radius: 5px;
    border-left: 3px solid var(--verde-terminal);
  }
  .tarjeta-proyecto h3 { margin: 0 0 10px 0; color: #e6ffe6; }
  .tarjeta-proyecto p { color: #8b949e; margin: 0; line-height: 1.5; }
  .cabecera-proyecto { display: flex; justify-content: space-between; align-items: center; margin-bottom: 10px; }
  .cabecera-proyecto h3 { margin: 0; }
  .badge { background: #ffbd2e; color: #000; font-size: 0.75rem; padding: 3px 8px; border-radius: 12px; font-weight: bold; }

  .grid-contacto { display: flex; gap: 15px; flex-wrap: wrap; }
  .btn-contacto {
    background: var(--gris-oscuro);
    border: 1px solid var(--borde);
    padding: 12px 25px;
    color: var(--texto);
    text-decoration: none;
    border-radius: 5px;
    transition: border-color 0.2s;
  }
  .btn-contacto:hover { border-color: var(--verde-terminal); }
</style>