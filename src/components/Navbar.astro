---
import translations from '../data/language.json';
const idiomaPorDefecto = "es" as keyof typeof translations;
const t = translations[idiomaPorDefecto];
---

<nav class="navbar">
  <div class="nav-contenido">
    <a href="/" class="logo">Jordi_OS</a>
    <div class="enlaces">
      <a href="/#inicio">~/Inicio</a>
      <a href="/#sobre-mi">~/Sobre mí</a>
      <a href="/proyectos">~/Proyectos</a>
      
      <select id="selector-idioma" class="selector-terminal">
        <option value="es">ES</option>
        <option value="en">EN</option>
        <option value="ca">CA</option>
      </select>
    </div>
  </div>
</nav>

<style>
  .navbar {
    position: fixed;
    top: 0;
    width: 100%;
    background: rgba(13, 17, 23, 0.9);
    backdrop-filter: blur(5px);
    border-bottom: 1px solid #30363d;
    z-index: 100;
  }
  .nav-contenido {
    max-width: 800px;
    margin: 0 auto;
    padding: 15px 20px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-family: "Courier New", Courier, monospace;
  }
  .logo { font-weight: bold; color: #33ff66; text-decoration: none; }
  .enlaces { display: flex; align-items: center; gap: 15px; }
  .enlaces a { color: #e6ffe6; text-decoration: none; font-size: 0.9rem; transition: color 0.2s; }
  .enlaces a:hover { color: #33ff66; }
  .selector-terminal {
    background-color: #0d1117;
    color: #33ff66;
    border: 1px solid #33ff66;
    padding: 4px 8px;
    border-radius: 4px;
    font-family: inherit;
    font-size: 0.85rem;
    cursor: pointer;
    outline: none;
  }
</style>