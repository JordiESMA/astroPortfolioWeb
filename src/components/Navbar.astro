---
import translations from '../data/language.json';
const idiomaPorDefecto = "es" as keyof typeof translations;
const t = translations[idiomaPorDefecto];

const currentPath = Astro.url.pathname;
---

<header class="navbar-wrapper">
  <nav class="floating-nav">
    <a href="/" class="brand-link">
      <div class="avatar-ring">
        <span class="avatar-text">JE</span>
      </div>
      <div class="brand-text-group">
        <span class="brand-title">Jordi Estirado</span>
        <span class="brand-role">Software Dev</span>
      </div>
    </a>

    <div class="nav-links-capsule">
      <a href="/" class={currentPath === '/' ? 'active' : ''} data-i18n="nav_inicio">
        {t.nav_inicio}
      </a>
      <a href="/sobre-mi" class={currentPath.startsWith('/sobre-mi') ? 'active' : ''} data-i18n="nav_sobre_mi">
        {t.nav_sobre_mi}
      </a>
      <a href="/proyectos" class={currentPath.startsWith('/proyectos') ? 'active' : ''} data-i18n="nav_proyectos">
        {t.nav_proyectos}
      </a>
      <a href="/contacto" class={currentPath.startsWith('/contacto') ? 'active' : ''} data-i18n="nav_contacto">
        {t.nav_contacto}
      </a>
    </div>

    <div class="lang-capsule">
      <svg class="lang-icon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="12" cy="12" r="10"></circle>
        <line x1="2" y1="12" x2="22" y2="12"></line>
        <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
      </svg>
      <select id="selector-idioma" class="lang-select" aria-label="Seleccionar idioma">
        <option value="es">ES</option>
        <option value="en">EN</option>
        <option value="ca">CA</option>
      </select>
    </div>
  </nav>
</header>

<style>
  .navbar-wrapper {
    position: fixed;
    top: 16px;
    left: 0;
    width: 100%;
    z-index: 50;
    padding: 0 16px;
    pointer-events: none;
  }

  .floating-nav {
    pointer-events: auto;
    max-width: 960px;
    margin: 0 auto;
    padding: 8px 14px;
    background: rgba(14, 16, 22, 0.75);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: var(--radius-full);
    box-shadow: 0 12px 32px -8px rgba(0, 0, 0, 0.7), 0 0 0 1px rgba(255, 255, 255, 0.05);
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .brand-link {
    display: flex;
    align-items: center;
    gap: 12px;
    padding-left: 4px;
  }

  .avatar-ring {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: linear-gradient(135deg, #a855f7 0%, #6366f1 100%);
    padding: 2px;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 0 14px rgba(168, 85, 247, 0.35);
  }

  .avatar-text {
    width: 100%;
    height: 100%;
    background: #090a0f;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.8rem;
    font-weight: 800;
    color: #e2e8f0;
    letter-spacing: -0.5px;
  }

  .brand-text-group {
    display: flex;
    flex-direction: column;
  }

  .brand-title {
    font-weight: 700;
    font-size: 0.92rem;
    color: var(--text-main);
    letter-spacing: -0.3px;
  }

  .brand-role {
    font-size: 0.72rem;
    color: var(--text-muted);
    font-weight: 500;
  }

  .nav-links-capsule {
    display: flex;
    align-items: center;
    gap: 4px;
    background: rgba(255, 255, 255, 0.04);
    padding: 4px;
    border-radius: var(--radius-full);
    border: 1px solid rgba(255, 255, 255, 0.04);
  }

  .nav-links-capsule a {
    padding: 7px 16px;
    border-radius: var(--radius-full);
    font-size: 0.86rem;
    font-weight: 600;
    color: var(--text-muted);
    transition: var(--transition);
  }

  .nav-links-capsule a:hover {
    color: var(--text-main);
    background: rgba(255, 255, 255, 0.06);
  }

  .nav-links-capsule a.active {
    color: #ffffff;
    background: linear-gradient(135deg, #8b5cf6 0%, #7c3aed 100%);
    box-shadow: 0 2px 12px rgba(139, 92, 246, 0.4);
  }

  .lang-capsule {
    display: flex;
    align-items: center;
    gap: 6px;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid var(--border-subtle);
    padding: 6px 12px;
    border-radius: var(--radius-full);
    transition: var(--transition);
  }

  .lang-capsule:hover {
    border-color: var(--border-hover);
    background: rgba(255, 255, 255, 0.08);
  }

  .lang-icon {
    color: var(--primary-light);
  }

  .lang-select {
    background: transparent;
    border: none;
    color: var(--text-main);
    font-size: 0.82rem;
    font-weight: 700;
    cursor: pointer;
    outline: none;
  }

  .lang-select option {
    background-color: #12141a;
    color: var(--text-main);
  }

  @media (max-width: 720px) {
    .brand-text-group {
      display: none;
    }
    .nav-links-capsule a {
      padding: 6px 10px;
      font-size: 0.78rem;
    }
  }
</style>