---
import Layout from '../layouts/Layout.astro';
import Badges from '../components/Badges.astro';
import proyectos from '../data/projects.json';
import es from '../data/es.json';
const textos: Record<string,string> = es;
const tecnologias = [...new Set(proyectos.flatMap(p => p.tecnologias.map(t => t.nombre)))].sort();
const categorias = ['grupo_web', 'grupo_android', 'grupo_juegos', 'grupo_ejercicios'] as const;
const grupos = categorias.map(key => {
  const proyectosDelGrupo = proyectos.filter(p => p.grupo === key);
  return { key, proyectosDelGrupo, muestra: proyectosDelGrupo.find(p => p.imagen) };
});
---
<Layout title="Proyectos | Jordi Estirado">
  <header class="cabecera-catalogo">
    <div><h1 data-idioma="proyectos_titulo">{es.proyectos_titulo}</h1>
    <p data-idioma="proyectos_subtitulo">{es.proyectos_subtitulo}</p></div>
    <div class="control-filtro">
      <label for="filtro" data-idioma="proyectos_filtrar">{es.proyectos_filtrar}</label>
      <select id="filtro">
        <option value="" data-idioma="proyectos_todos">{es.proyectos_todos}</option>
        {tecnologias.map(t => <option>{t}</option>)}
      </select>
    </div>
  </header>
  {grupos.map(({ key, proyectosDelGrupo, muestra }) => <section class="grupo-proyectos">
    <header class="categoria-proyectos">
      <h2 data-idioma={key}>{es[key]}</h2>
      {muestra && <figure><img src={'/images/proyectos/' + muestra.imagen + '.webp'} alt="" loading="lazy" /><figcaption>{muestra.nombre}</figcaption></figure>}
    </header>
    <div class="filas">{proyectosDelGrupo.map(p =>
      <article class="fila-proyecto" data-tecnologias={JSON.stringify(p.tecnologias.map(t=>t.nombre))}>
        <div><h3>{p.nombre}</h3><p data-idioma={p.descripcionKey}>{textos[p.descripcionKey]}</p></div>
        <Badges tecnologias={p.tecnologias} />
        <a class="codigo" href={p.githubUrl} aria-label={p.nombre + ' · GitHub'}>GitHub ↗</a>
      </article>)}</div>
  </section>)}
</Layout>
