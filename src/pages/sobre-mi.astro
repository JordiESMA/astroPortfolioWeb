---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Sobre mí | Jordi Estirado">
  <header class="biografia">
    <img src="/images/photo_cv.jpeg" alt="Jordi Estirado" class="foto" />
    <div>
      <h1 data-idioma="sobreMi_titulo"></h1>
      <p class="bio-entrada" data-idioma="sobreMi_subtitulo"></p>
      <p data-idioma="sobreMi_texto"></p>
    </div>
  </header>

  <section class="bloque-bio">
    <h2 data-idioma="carrera_titulo"></h2>
    <div class="trayectoria">
      <article>
        <h3 data-idioma="carrera_practicas_titulo"></h3>
        <p data-idioma="carrera_practicas_texto"></p>
      </article>
      <article>
        <h3 data-idioma="carrera_dam_titulo"></h3>
        <p data-idioma="carrera_dam_texto"></p>
      </article>
    </div>
  </section>

  <section class="bloque-bio">
    <h2 data-idioma="habilidadesAptitudes_titulo"></h2>
    <p data-idioma="habilidadesAptitudes_texto"></p>
  </section>

  <section>
    <h2 data-idioma="lenguajes_titulo"></h2>
    <div id="stack-lista" class="rejilla"></div>
  </section>
</Layout>
