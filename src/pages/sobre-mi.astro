---
import es from '../data/es.json';
import stack from '../data/labelsLanguage.json';
const strings: Record<string,string> = es;
import Layout from '../layouts/Layout.astro';
---

<Layout title="Sobre mí | Jordi Estirado">
  <h1 data-idioma="sobreMi_titulo">{es.sobreMi_titulo}</h1>
  <p data-idioma="sobreMi_subtitulo">{es.sobreMi_subtitulo}</p>
  <p data-idioma="sobreMi_texto">{es.sobreMi_texto}</p>

  <h2 data-idioma="sobrePro_titulo">{es.sobrePro_titulo}</h2>
  <p data-idioma="sobrePro_texto">{es.sobrePro_texto}</p>

  <h2 data-idioma="carrera_titulo">{es.carrera_titulo}</h2>
  <div class="rejilla">
    <div class="tarjeta">
      <h3 data-idioma="carrera_dam_titulo">{es.carrera_dam_titulo}</h3>
      <p data-idioma="carrera_dam_texto">{es.carrera_dam_texto}</p>
    </div>
    <div class="tarjeta">
      <h3 data-idioma="carrera_practicas_titulo">{es.carrera_practicas_titulo}</h3>
      <p data-idioma="carrera_practicas_texto">{es.carrera_practicas_texto}</p>
    </div>
  </div>

  <h2 data-idioma="lenguajes_titulo">{es.lenguajes_titulo}</h2>
  <div class="rejilla">{stack.map(group => <section class="tarjeta">
    <h3 data-idioma={group.categoriaKey}>{strings[group.categoriaKey]}</h3>
    <div class="badges">{group.tecnologias.map(t => <span>{t}</span>)}</div>
  </section>)}</div>

  <h2 data-idioma="habilidadesAptitudes_titulo">{es.habilidadesAptitudes_titulo}</h2>
  <p data-idioma="habilidadesAptitudes_texto">{es.habilidadesAptitudes_texto}</p>
</Layout>
