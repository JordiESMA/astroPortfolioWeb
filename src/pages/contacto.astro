---
import Layout from '../layouts/Layout.astro';
import translations from '../data/language.json';

const t = translations["es"];
---

<Layout title="Contacto | Jordi Estirado">
  <div class="page-container">
    <!-- CABECERA -->
    <header class="page-header">
      <div class="kicker-badge">Hablemos</div>
      <h1 data-i18n="contacto_titulo">{t.contacto_titulo}</h1>
      <p class="page-subtitle" data-i18n="contacto_subtitulo">
        {t.contacto_subtitulo}
      </p>
    </header>

    <div class="contact-layout">
      <!-- COLUMNA IZQUIERDA: ESTADO Y DISPONIBILIDAD -->
      <div class="info-sidebar">
        <div class="status-box">
          <div class="status-indicator-wrap">
            <span class="pulse-emerald"></span>
            <span class="status-label">Búsqueda activa</span>
          </div>
          <h3>¿Tienes una oportunidad o proyecto en mente?</h3>
          <p>
            Estoy disponible para incorporarme a equipos de desarrollo de software, proyectos interesantes o prácticas formativas.
          </p>
        </div>

        <div class="email-direct-box">
          <span class="email-label">Email directo:</span>
          <div class="email-display">
            <code>estiradojordi@gmail.com</code>
          </div>
        </div>
      </div>

      <!-- COLUMNA DERECHA: TARJETAS DE CANALES -->
      <div class="channels-grid">
        <!-- Tarjeta Email -->
        <a href="mailto:estiradojordi@gmail.com" class="channel-card card-email">
          <div class="card-icon-sphere sphere-purple">
            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
              <polyline points="22,6 12,13 2,6"></polyline>
            </svg>
          </div>
          <div class="card-details">
            <span class="channel-type">Correo electrónico</span>
            <h3>estiradojordi@gmail.com</h3>
            <p>Escríbeme directo a mi bandeja de entrada.</p>
          </div>
          <div class="action-circle">
            <span>↗</span>
          </div>
        </a>

        <!-- Tarjeta LinkedIn -->
        <a href="https://www.linkedin.com/in/jordiestiradomartinez/" target="_blank" rel="noopener noreferrer" class="channel-card card-linkedin">
          <div class="card-icon-sphere sphere-cyan">
            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path>
              <rect x="2" y="9" width="4" height="12"></rect>
              <circle cx="4" cy="4" r="2"></circle>
            </svg>
          </div>
          <div class="card-details">
            <span class="channel-type">Red profesional</span>
            <h3>Perfil en LinkedIn</h3>
            <p>Conecta conmigo y conoce mi red y trayectoria profesional.</p>
          </div>
          <div class="action-circle">
            <span>↗</span>
          </div>
        </a>

        <!-- Tarjeta GitHub -->
        <a href="https://github.com/JordiESMA" target="_blank" rel="noopener noreferrer" class="channel-card card-github">
          <div class="card-icon-sphere sphere-dark">
            <svg width="26" height="26" viewBox="0 0 24 24" fill="currentColor">
              <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"></path>
            </svg>
          </div>
          <div class="card-details">
            <span class="channel-type">Código fuente</span>
            <h3>GitHub / JordiESMA</h3>
            <p>Revisa mis commits, ramas, repositorios y proyectos en curso.</p>
          </div>
          <div class="action-circle">
            <span>↗</span>
          </div>
        </a>
      </div>
    </div>
  </div>
</Layout>

<style>
  .page-container {
    display: flex;
    flex-direction: column;
    gap: 40px;
  }

  .kicker-badge {
    font-size: 0.76rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    color: var(--primary-light);
    margin-bottom: 8px;
  }

  .page-header {
    border-bottom: 1px solid var(--border-subtle);
    padding-bottom: 24px;
  }

  .page-header h1 {
    font-size: clamp(2.2rem, 4vw, 3rem);
    letter-spacing: -1px;
    margin-bottom: 8px;
    background: linear-gradient(135deg, #ffffff 40%, #c084fc 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .page-subtitle {
    color: var(--text-muted);
    font-size: 1.05rem;
    margin: 0;
    max-width: 650px;
  }

  .contact-layout {
    display: grid;
    grid-template-columns: 320px 1fr;
    gap: 32px;
    align-items: flex-start;
  }

  /* Sidebar */
  .info-sidebar {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .status-box {
    background: rgba(18, 20, 26, 0.7);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    padding: 24px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .status-indicator-wrap {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: rgba(16, 185, 129, 0.1);
    border: 1px solid rgba(16, 185, 129, 0.25);
    padding: 4px 12px;
    border-radius: var(--radius-full);
    width: fit-content;
  }

  .pulse-emerald {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #10b981;
    box-shadow: 0 0 8px #10b981;
  }

  .status-label {
    font-size: 0.75rem;
    font-weight: 700;
    color: #34d399;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .status-box h3 {
    font-size: 1.15rem;
    margin: 0;
  }

  .status-box p {
    color: var(--text-muted);
    font-size: 0.92rem;
    line-height: 1.6;
    margin: 0;
  }

  .email-direct-box {
    background: rgba(18, 20, 26, 0.7);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    padding: 16px 20px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .email-label {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.6px;
    color: var(--text-faint);
  }

  .email-display code {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.9rem;
    color: var(--primary-light);
  }

  /* Channels Grid */
  .channels-grid {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .channel-card {
    position: relative;
    background: rgba(18, 20, 26, 0.7);
    backdrop-filter: blur(16px);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    padding: 24px 28px;
    display: flex;
    align-items: center;
    gap: 22px;
    transition: var(--transition);
    overflow: hidden;
  }

  .channel-card:hover {
    transform: translateX(6px);
    border-color: var(--border-hover);
    box-shadow: var(--shadow-card-hover);
  }

  .card-icon-sphere {
    width: 56px;
    height: 56px;
    border-radius: 16px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    border: 1px solid rgba(255, 255, 255, 0.1);
  }

  .sphere-purple {
    background: rgba(168, 85, 247, 0.15);
    color: var(--primary-light);
  }

  .sphere-cyan {
    background: rgba(56, 189, 248, 0.15);
    color: #38bdf8;
  }

  .sphere-dark {
    background: rgba(255, 255, 255, 0.08);
    color: #ffffff;
  }

  .card-details {
    flex: 1;
  }

  .channel-type {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.8px;
    color: var(--primary-light);
    display: block;
    margin-bottom: 4px;
  }

  .card-details h3 {
    font-size: 1.25rem;
    margin-bottom: 4px;
  }

  .card-details p {
    color: var(--text-muted);
    font-size: 0.92rem;
    margin: 0;
  }

  .action-circle {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.05);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.2rem;
    color: var(--text-muted);
    transition: var(--transition);
    flex-shrink: 0;
  }

  .channel-card:hover .action-circle {
    background: var(--primary);
    color: #ffffff;
    transform: scale(1.1);
  }

  @media (max-width: 820px) {
    .contact-layout {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 580px) {
    .channel-card {
      flex-direction: column;
      align-items: flex-start;
      gap: 16px;
    }
    .action-circle {
      align-self: flex-end;
    }
  }
</style>
