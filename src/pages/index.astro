---
import Layout from '../layouts/Layout.astro';
import Projects from '../components/Projects.astro';
import es from '../data/es.json';
const base = import.meta.env.BASE_URL;
---
<Layout title="Jordi Estirado | Portfolio">
  <section class="perfil">
    <div>
      <p class="estado" data-idioma="hero_saludo">{es.hero_saludo}</p>
      <h1>Jordi Estirado</h1>
      <h2 data-idioma="hero_subtitulo">{es.hero_subtitulo}</h2>
      <p data-idioma="inicio_texto">{es.inicio_texto}</p>
      <div class="acciones">
        <a class="boton" href={base + 'proyectos/'} data-idioma="hero_cta_proyectos">{es.hero_cta_proyectos}</a>
        <a class="boton boton-claro" href={base + 'contacto/'} data-idioma="hero_cta_contacto">{es.hero_cta_contacto}</a>
      </div>
    </div>
    <div class="retrato"><img src={base + 'images/photo_cv.jpeg'} alt="Jordi Estirado" class="foto" /></div>
  </section>
  <div class="titulo-seccion">
    <h2 data-idioma="inicio_proyectos_titulo">{es.inicio_proyectos_titulo}</h2>
    <a class="enlace" href={base + 'proyectos/'} data-idioma="btn_ver_mas">{es.btn_ver_mas}</a>
  </div>
  <Projects featured />
</Layout>
