---
import Layout from '../layouts/Layout.astro';
import translations from '../data/language.json';
import projects from '../data/projects.json';

const t = translations["es"];
---

<Layout title="Jordi Estirado | Portafolio">
  <!-- HERO PRINCIPAL DE ALTO IMPACTO -->
  <section class="hero-container">
    <div class="status-pill">
      <span class="pulsing-dot"></span>
      <span>Disponible para proyectos & prácticas</span>
    </div>

    <h1 class="hero-headline">
      <span class="hero-sub" data-i18n="hero_saludo">{t.hero_saludo}</span>
      <span class="hero-gradient-name">Jordi Estirado</span>
    </h1>

    <p class="hero-tagline" data-i18n="hero_subtitulo">
      {t.hero_subtitulo}
    </p>

    <p class="hero-bio" data-i18n="inicio_texto">
      {t.inicio_texto}
    </p>

    <div class="hero-cta-group">
      <a href="/proyectos" class="btn btn-glow" data-i18n="hero_cta_proyectos">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="16 18 22 12 16 6"></polyline>
          <polyline points="8 6 2 12 8 18"></polyline>
        </svg>
        {t.hero_cta_proyectos}
      </a>
      <a href="/contacto" class="btn btn-outline" data-i18n="hero_cta_contacto">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
          <polyline points="22,6 12,13 2,6"></polyline>
        </svg>
        {t.hero_cta_contacto}
      </a>
    </div>

    <!-- CINTA DE MÉTRICAS / HIGHLIGHTS -->
    <div class="metrics-strip">
      <div class="metric-item">
        <span class="metric-number">2+</span>
        <span class="metric-label">Proyectos clave</span>
      </div>
      <div class="metric-separator"></div>
      <div class="metric-item">
        <span class="metric-number">8+</span>
        <span class="metric-label">Tecnologías</span>
      </div>
      <div class="metric-separator"></div>
      <div class="metric-item">
        <span class="metric-number">DAM</span>
        <span class="metric-label">Grado Superior</span>
      </div>
      <div class="metric-separator"></div>
      <div class="metric-item">
        <span class="metric-number">Velneo</span>
        <span class="metric-label">ERP en Prácticas</span>
      </div>
    </div>
  </section>

  <!-- HUB DE SECCIONES INTERACTIVAS -->
  <section class="hub-container">
    <div class="section-title-wrap">
      <span class="section-kicker">Navegación</span>
      <h2 data-i18n="seccion_resumen_titulo">{t.seccion_resumen_titulo}</h2>
    </div>

    <div class="hub-cards-grid">
      <!-- Tarjeta 1: Sobre Mí -->
      <a href="/sobre-mi" class="feature-card">
        <div class="card-glow-bg"></div>
        <div class="card-icon-bubble bubble-purple">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
            <circle cx="12" cy="7" r="4"></circle>
          </svg>
        </div>
        <div class="card-content">
          <h3 data-i18n="sobreMi_titulo">{t.sobreMi_titulo}</h3>
          <p data-i18n="card_sobre_mi_desc">{t.card_sobre_mi_desc}</p>
        </div>
        <div class="card-action-row">
          <span class="action-text" data-i18n="btn_ver_mas">{t.btn_ver_mas}</span>
          <div class="action-arrow">→</div>
        </div>
      </a>

      <!-- Tarjeta 2: Proyectos -->
      <a href="/proyectos" class="feature-card highlighted-card">
        <div class="card-glow-bg"></div>
        <div class="card-badge-top">Recomendado</div>
        <div class="card-icon-bubble bubble-cyan">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polygon points="12 2 2 7 12 12 22 7 12 2"></polygon>
            <polyline points="2 17 12 22 22 17"></polyline>
            <polyline points="2 12 12 17 22 12"></polyline>
          </svg>
        </div>
        <div class="card-content">
          <h3 data-i18n="proyectos_titulo">{t.proyectos_titulo}</h3>
          <p data-i18n="card_proyectos_desc">{t.card_proyectos_desc}</p>
          <div class="tags-row">
            <span class="tech-chip">Java</span>
            <span class="tech-chip">Spring Boot</span>
            <span class="tech-chip">JavaScript</span>
            <span class="tech-chip">PostgreSQL</span>
          </div>
        </div>
        <div class="card-action-row">
          <span class="action-text" data-i18n="btn_ver_mas">{t.btn_ver_mas}</span>
          <div class="action-arrow">→</div>
        </div>
      </a>

      <!-- Tarjeta 3: Contacto -->
      <a href="/contacto" class="feature-card">
        <div class="card-glow-bg"></div>
        <div class="card-icon-bubble bubble-emerald">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
          </svg>
        </div>
        <div class="card-content">
          <h3 data-i18n="contacto_titulo">{t.contacto_titulo}</h3>
          <p data-i18n="card_contacto_desc">{t.card_contacto_desc}</p>
        </div>
        <div class="card-action-row">
          <span class="action-text" data-i18n="btn_ver_mas">{t.btn_ver_mas}</span>
          <div class="action-arrow">→</div>
        </div>
      </a>
    </div>
  </section>
</Layout>

<style>
  /* HERO */
  .hero-container {
    padding: 20px 0 60px;
    max-width: 860px;
  }

  .status-pill {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    background: rgba(16, 185, 129, 0.08);
    border: 1px solid rgba(16, 185, 129, 0.25);
    padding: 6px 16px;
    border-radius: var(--radius-full);
    font-size: 0.82rem;
    font-weight: 600;
    color: #34d399;
    margin-bottom: 24px;
    box-shadow: 0 0 20px rgba(16, 185, 129, 0.1);
  }

  .pulsing-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: #10b981;
    box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.7);
    animation: pulse 2s infinite;
  }

  @keyframes pulse {
    0% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.7); }
    70% { transform: scale(1); box-shadow: 0 0 0 8px rgba(16, 185, 129, 0); }
    100% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(16, 185, 129, 0); }
  }

  .hero-headline {
    font-size: clamp(2.8rem, 6vw, 4.2rem);
    font-weight: 800;
    letter-spacing: -2px;
    line-height: 1.1;
    margin-bottom: 16px;
    display: flex;
    flex-direction: column;
  }

  .hero-sub {
    font-size: 0.45em;
    font-weight: 500;
    color: var(--text-muted);
    letter-spacing: normal;
  }

  .hero-gradient-name {
    background: linear-gradient(135deg, #ffffff 30%, #c084fc 70%, #818cf8 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .hero-tagline {
    font-size: 1.35rem;
    font-weight: 600;
    color: var(--primary-light);
    margin: 0 0 16px 0;
    letter-spacing: -0.3px;
  }

  .hero-bio {
    font-size: 1.1rem;
    color: var(--text-muted);
    line-height: 1.75;
    margin: 0 0 32px 0;
    max-width: 720px;
  }

  .hero-cta-group {
    display: flex;
    gap: 16px;
    flex-wrap: wrap;
    margin-bottom: 48px;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 14px 26px;
    border-radius: var(--radius-md);
    font-weight: 700;
    font-size: 0.95rem;
    transition: var(--transition);
    cursor: pointer;
  }

  .btn-glow {
    background: linear-gradient(135deg, #8b5cf6 0%, #6d28d9 100%);
    color: #ffffff;
    border: 1px solid rgba(255, 255, 255, 0.2);
    box-shadow: 0 4px 25px rgba(139, 92, 246, 0.45);
  }

  .btn-glow:hover {
    transform: translateY(-3px) scale(1.02);
    box-shadow: 0 8px 35px rgba(139, 92, 246, 0.6);
  }

  .btn-outline {
    background: rgba(255, 255, 255, 0.03);
    color: var(--text-main);
    border: 1px solid var(--border-subtle);
    backdrop-filter: blur(10px);
  }

  .btn-outline:hover {
    border-color: rgba(255, 255, 255, 0.3);
    background: rgba(255, 255, 255, 0.08);
    transform: translateY(-3px);
  }

  /* METRICS STRIP */
  .metrics-strip {
    display: flex;
    align-items: center;
    gap: 24px;
    background: rgba(18, 20, 26, 0.6);
    backdrop-filter: blur(16px);
    border: 1px solid var(--border-subtle);
    padding: 16px 28px;
    border-radius: var(--radius-lg);
    width: fit-content;
    box-shadow: var(--shadow-card);
  }

  .metric-item {
    display: flex;
    flex-direction: column;
  }

  .metric-number {
    font-size: 1.4rem;
    font-weight: 800;
    background: linear-gradient(135deg, #ffffff 40%, #c084fc 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    line-height: 1.2;
  }

  .metric-label {
    font-size: 0.76rem;
    color: var(--text-muted);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .metric-separator {
    width: 1px;
    height: 32px;
    background: var(--border-subtle);
  }

  /* HUB SECTIONS */
  .hub-container {
    padding-top: 50px;
  }

  .section-title-wrap {
    margin-bottom: 28px;
  }

  .section-kicker {
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    color: var(--primary-light);
    display: block;
    margin-bottom: 6px;
  }

  .section-title-wrap h2 {
    font-size: 1.7rem;
    letter-spacing: -0.7px;
  }

  .hub-cards-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(310px, 1fr));
    gap: 24px;
  }

  .feature-card {
    position: relative;
    background: rgba(18, 20, 26, 0.7);
    backdrop-filter: blur(16px);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    padding: 30px 26px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    transition: var(--transition);
    overflow: hidden;
  }

  .highlighted-card {
    border-color: rgba(168, 85, 247, 0.35);
    background: linear-gradient(180deg, rgba(26, 22, 38, 0.7) 0%, rgba(18, 20, 26, 0.7) 100%);
  }

  .card-badge-top {
    position: absolute;
    top: 16px;
    right: 18px;
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.8px;
    padding: 3px 10px;
    border-radius: var(--radius-full);
    background: rgba(168, 85, 247, 0.2);
    color: var(--primary-light);
    border: 1px solid rgba(168, 85, 247, 0.4);
  }

  .feature-card:hover {
    transform: translateY(-6px);
    border-color: var(--border-hover);
    box-shadow: var(--shadow-card-hover);
  }

  .card-icon-bubble {
    width: 48px;
    height: 48px;
    border-radius: 14px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 20px;
    border: 1px solid rgba(255, 255, 255, 0.1);
  }

  .bubble-purple {
    background: rgba(139, 92, 246, 0.15);
    color: var(--primary-light);
  }

  .bubble-cyan {
    background: rgba(56, 189, 248, 0.15);
    color: #38bdf8;
  }

  .bubble-emerald {
    background: rgba(16, 185, 129, 0.15);
    color: #34d399;
  }

  .feature-card h3 {
    font-size: 1.3rem;
    margin-bottom: 8px;
  }

  .feature-card p {
    color: var(--text-muted);
    font-size: 0.95rem;
    line-height: 1.65;
    margin: 0 0 20px 0;
  }

  .tags-row {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 20px;
  }

  .tech-chip {
    font-size: 0.74rem;
    font-weight: 600;
    padding: 4px 10px;
    border-radius: var(--radius-sm);
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.06);
    color: #cbd5e1;
  }

  .card-action-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 14px;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
  }

  .action-text {
    font-size: 0.9rem;
    font-weight: 700;
    color: var(--primary-light);
  }

  .action-arrow {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.05);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--primary-light);
    transition: var(--transition);
  }

  .feature-card:hover .action-arrow {
    background: var(--primary);
    color: #ffffff;
    transform: translateX(4px);
  }

  @media (max-width: 680px) {
    .metrics-strip {
      flex-direction: column;
      align-items: flex-start;
      width: 100%;
      gap: 16px;
    }
    .metric-separator {
      width: 100%;
      height: 1px;
    }
  }
</style>
